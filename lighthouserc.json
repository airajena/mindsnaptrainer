{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec next start -p 3200",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://127.0.0.1:3200/",
        "http://127.0.0.1:3200/privacy",
        "http://127.0.0.1:3200/train"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertMatrix": [
        {
          "matchingUrlPattern": "http://127.0.0.1:3200/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 1800 }]
          }
        },
        {
          "matchingUrlPattern": "http://127.0.0.1:3200/$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.95 }]
          }
        },
        {
          "matchingUrlPattern": ".*/(privacy|train)$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
